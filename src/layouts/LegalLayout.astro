---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Icon from '../components/ui/Icon.astro';
import { site } from '../config/site';

interface Props {
  title: string;
  description: string;
  path: string;
  updated?: string;
}
const { title, description, path, updated = 'October 2026' } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Legal', path: '/legal/privacy/' }, { name: title, path }]}
>
  <Section tone="white">
    <div class="mx-auto max-w-3xl">
      <div class="mb-8 flex items-start gap-3 rounded-xl border-l-4 border-warning bg-[#fdf1e0] p-4 text-sm text-slate-700">
        <Icon name="alert" size={20} class="mt-0.5 h-5 w-5 shrink-0 text-warning-text" />
        <p>
          <strong class="font-bold">Draft — not legal advice.</strong> This document must be reviewed and approved by an
          attorney before the site goes live. See TODO.md.
        </p>
      </div>

      <h1 class="text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">{title}</h1>
      <p class="mt-2 text-sm text-slate-600">Last updated: {updated} · {site.legalName}</p>

      <div class="prose-legal mt-8">
        <slot />
      </div>

      <p class="mt-10 border-t border-slate-200 pt-6 text-sm text-slate-600">
        Questions about this document? Email
        <a href={`mailto:${site.email}`} class="font-semibold text-deep underline underline-offset-2">{site.email}</a>
        or WhatsApp {site.whatsappNumber}.
      </p>
    </div>
  </Section>
</BaseLayout>
