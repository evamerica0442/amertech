---
import Icon from './ui/Icon.astro';
import WhatsAppQr from './ui/WhatsAppQr.astro';
import { site } from '../config/site';
---

{/* Floating WhatsApp button on every page; QR shown on desktop hover only. */}
<div class="fixed bottom-5 right-5 z-40 print:hidden">
  <div class="group relative">
    <div
      class="pointer-events-none absolute bottom-full right-0 mb-3 hidden origin-bottom-right rounded-2xl border border-slate-200 bg-white p-4 opacity-0 shadow-xl transition-opacity group-hover:opacity-100 group-focus-within:opacity-100 md:block"
    >
      <WhatsAppQr size={150} />
    </div>
    <a
      href={site.whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-2 rounded-full bg-success px-4 py-3.5 font-bold text-white shadow-lg transition-transform hover:scale-105"
      aria-label={`Chat with ATS on WhatsApp: ${site.whatsappNumber}`}
    >
      <Icon name="whatsapp" size={26} class="h-7 w-7" />
      <span class="hidden sm:inline">WhatsApp us</span>
    </a>
  </div>
</div>
