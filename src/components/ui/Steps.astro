---
interface Step {
  title: string;
  body: string;
}
interface Props {
  steps: readonly Step[];
  tone?: 'light' | 'dark';
}
const { steps, tone = 'light' } = Astro.props;
const titleCls = tone === 'dark' ? 'text-white' : 'text-ink';
const bodyCls = tone === 'dark' ? 'text-silver' : 'text-slate-600';
const badgeCls = tone === 'dark' ? 'bg-blue text-navy' : 'bg-deep text-white';
---

<ol class="grid gap-8 md:grid-cols-3">
  {
    steps.map((s, i) => (
      <li class="relative">
        <div class={`mb-4 flex h-11 w-11 items-center justify-center rounded-full text-lg font-extrabold ${badgeCls}`}>
          {i + 1}
        </div>
        <h3 class={`text-xl font-bold ${titleCls}`}>{s.title}</h3>
        <p class={`mt-2 ${bodyCls}`}>{s.body}</p>
      </li>
    ))
  }
</ol>
