---
/**
 * Section wrapper with the ATS band rhythm: white → soft-blue → navy.
 * `tone="navy"` applies the glow-navy background and light text.
 */
interface Props {
  tone?: 'white' | 'soft' | 'navy';
  id?: string;
  class?: string;
  container?: boolean;
}
const { tone = 'white', id, class: className = '', container = true } = Astro.props;

const tones = {
  white: 'bg-page text-ink',
  soft: 'bg-soft text-ink',
  navy: 'glow-navy text-white on-dark',
} as const;
---

<section id={id} class={`${tones[tone]} py-16 md:py-20 ${className}`}>
  {container ? <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">{<slot />}</div> : <slot />}
</section>
