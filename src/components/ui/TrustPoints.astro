---
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Point {
  icon: IconName;
  label: string;
}

interface Props {
  points: readonly Point[];
  tone?: 'light' | 'dark';
}
const { points, tone = 'light' } = Astro.props;
const textCls = tone === 'dark' ? 'text-silver' : 'text-ink';
const iconCls = tone === 'dark' ? 'text-blue' : 'text-deep';
---

<ul class={`grid grid-cols-2 gap-x-4 gap-y-6 sm:grid-cols-4 ${tone === 'dark' ? 'text-white' : ''}`}>
  {
    points.map((p) => (
      <li class="flex items-start gap-3">
        <span class={`shrink-0 ${iconCls}`}>
          <Icon name={p.icon} size={26} />
        </span>
        <span class={`text-sm font-semibold leading-snug ${textCls}`}>{p.label}</span>
      </li>
    ))
  }
</ul>
