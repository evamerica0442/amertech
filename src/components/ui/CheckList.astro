---
import Icon from './Icon.astro';

interface Props {
  items: readonly string[];
  columns?: 1 | 2;
  tone?: 'light' | 'dark';
}
const { items, columns = 1, tone = 'light' } = Astro.props;
const textCls = tone === 'dark' ? 'text-silver' : 'text-slate-700';
const cols = columns === 2 ? 'sm:grid-cols-2' : '';
---

<ul class={`grid gap-x-8 gap-y-3 ${cols}`}>
  {
    items.map((it) => (
      <li class={`flex items-start gap-3 ${textCls}`}>
        <Icon name="check" size={20} class="mt-0.5 h-5 w-5 shrink-0 text-success" />
        <span>{it}</span>
      </li>
    ))
  }
</ul>
