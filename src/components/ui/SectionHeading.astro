---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  level?: 2 | 3;
  align?: 'left' | 'center';
  tone?: 'light' | 'dark';
  id?: string;
  class?: string;
}
const {
  eyebrow,
  title,
  intro,
  level = 2,
  align = 'center',
  tone = 'light',
  id,
  class: className = '',
} = Astro.props;

const Heading = `h${level}` as const;
const alignCls = align === 'center' ? 'text-center mx-auto' : 'text-left';
const titleCls = tone === 'dark' ? 'text-white' : 'text-ink';
const eyebrowCls = tone === 'dark' ? 'text-blue' : 'text-deep';
const introCls = tone === 'dark' ? 'text-silver' : 'text-slate-600';
---

<div class={`max-w-2xl ${alignCls} ${className}`}>
  {eyebrow && <p class={`mb-2 text-sm font-bold uppercase tracking-wider ${eyebrowCls}`}>{eyebrow}</p>}
  <Heading id={id} class={`text-3xl font-extrabold tracking-tight sm:text-4xl ${titleCls}`}>{title}</Heading>
  {intro && <p class={`mt-4 text-lg ${introCls}`}>{intro}</p>}
</div>
