---
import Icon from '../ui/Icon.astro';
import { site } from '../../config/site';
---

<div class="hidden border-b border-white/10 bg-navy text-silver md:block">
  <div class="mx-auto flex w-full max-w-6xl items-center justify-between gap-6 px-4 py-1.5 text-sm sm:px-6">
    <ul class="flex items-center gap-6">
      <li>
        <a href={`mailto:${site.email}`} class="inline-flex items-center gap-2 hover:text-white">
          <Icon name="mail" size={16} class="h-4 w-4 text-blue" />
          <span>{site.email}</span>
        </a>
      </li>
      <li>
        <a href={site.whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 hover:text-white">
          <Icon name="whatsapp" size={16} class="h-4 w-4 text-blue" />
          <span>{site.whatsappNumber}</span>
        </a>
      </li>
    </ul>
    <p class="inline-flex items-center gap-2">
      <Icon name="clock" size={16} class="h-4 w-4 text-blue" />
      <span>{site.hours}</span>
    </p>
  </div>
</div>
