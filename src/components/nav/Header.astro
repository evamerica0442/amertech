---
import Logo from './Logo.astro';
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import MobileMenu from './MobileMenu.astro';
import { mainNav, isGroup, type NavItem } from '../../data/navigation';
---

<header class="sticky top-0 z-50 bg-navy/95 backdrop-blur supports-[backdrop-filter]:bg-navy/85 on-dark">
  <div class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="shrink-0 rounded focus-visible:outline-2" aria-label="America Technology Services — home">
      <Logo />
    </a>

    {/* Desktop navigation with CSS-only dropdowns (hover + focus-within). */}
    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-1 text-[15px] font-semibold text-silver">
        {
          mainNav.map((item) =>
            isGroup(item) ? (
              <li class="group relative">
                <button
                  type="button"
                  class="flex items-center gap-1 rounded-md px-3 py-2 text-white/90 hover:text-white group-focus-within:text-white"
                  aria-expanded="false"
                  data-dropdown
                >
                  {item.label}
                  <Icon name="chevron-down" size={16} class="h-4 w-4 transition-transform group-hover:rotate-180 group-focus-within:rotate-180" />
                </button>
                <ul class="invisible absolute left-0 top-full z-50 w-72 translate-y-1 rounded-xl border border-slate-200 bg-white p-2 opacity-0 shadow-xl transition-all group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100">
                  {item.children.map((child: NavItem) => (
                    <li>
                      <a href={child.href} class="block rounded-lg px-3 py-2 text-ink hover:bg-soft">
                        <span class="block font-semibold text-deep">{child.label}</span>
                        {child.description && <span class="mt-0.5 block text-sm font-normal text-slate-600">{child.description}</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a href={(item as NavItem).href} class="block rounded-md px-3 py-2 hover:text-white">
                  {(item as NavItem).label}
                </a>
              </li>
            )
          )
        }
      </ul>
    </nav>

    <div class="hidden lg:block">
      <Button href="/health-check/" variant="onDark">Get a Health Check</Button>
    </div>

    {/* Mobile controls */}
    <button
      type="button"
      class="inline-flex items-center justify-center rounded-md p-2 text-white lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-mobile-toggle
    >
      <span class="sr-only">Open menu</span>
      <Icon name="menu" size={26} class="h-7 w-7 [button[aria-expanded=true]_&]:hidden" />
    </button>
  </div>

  <MobileMenu />
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      menu.classList.toggle('hidden', open);
    });
  }
  // Keep desktop dropdown buttons honest for assistive tech.
  document.querySelectorAll<HTMLButtonElement>('[data-dropdown]').forEach((btn) => {
    const li = btn.closest('li');
    li?.addEventListener('mouseenter', () => btn.setAttribute('aria-expanded', 'true'));
    li?.addEventListener('mouseleave', () => btn.setAttribute('aria-expanded', 'false'));
  });
</script>
