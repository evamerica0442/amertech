---
import { mainNav, isGroup, type NavItem } from '../../data/navigation';
import { site } from '../../config/site';
import Icon from '../ui/Icon.astro';
---

<div id="mobile-menu" class="on-dark hidden border-t border-silver/30 bg-navy xl:hidden">
  <nav
    aria-label="Mobile"
    class="max-h-[calc(100vh-4rem)] w-full overflow-y-auto overscroll-contain px-4 py-4 sm:px-6"
  >
    <ul class="space-y-0.5">
      {
        mainNav.map((item) =>
          isGroup(item) ? (
            <li class="pt-2">
              <p class="px-2 text-xs font-bold uppercase tracking-wider text-blue">{item.label}</p>
              <ul class="mt-1 space-y-0.5 border-l border-white/10 pl-2">
                {item.children.map((child: NavItem) => (
                  <li>
                    <a href={child.href} class="block rounded-md px-2 py-2 text-[15px] font-medium text-silver hover:bg-white/5 hover:text-white">
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a href={(item as NavItem).href} class="block rounded-md px-2 py-2.5 text-[15px] font-medium text-silver hover:bg-white/5 hover:text-white">
                {(item as NavItem).label}
              </a>
            </li>
          )
        )
      }
    </ul>
    <div class="mt-4 flex flex-col gap-2 border-t border-white/10 pt-4">
      <a href="/health-check/" class="inline-flex w-full items-center justify-center gap-2 whitespace-nowrap rounded-full bg-blue px-5 py-2.5 text-[15px] font-medium text-navy hover:bg-white">
        Free Health Check
      </a>
      <a href={site.whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex w-full items-center justify-center gap-2 whitespace-nowrap rounded-full border border-white/20 px-5 py-2.5 text-[15px] font-medium text-white hover:bg-white/5">
        <Icon name="whatsapp" size={18} /> WhatsApp {site.whatsappNumber}
      </a>
    </div>
  </nav>
</div>
