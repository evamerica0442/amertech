---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/ui/Section.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import ServiceCard from '../components/ui/ServiceCard.astro';
import FaqAccordion from '../components/ui/FaqAccordion.astro';
import ContactForm from '../components/ContactForm.astro';
import PopiaNote from '../components/ui/PopiaNote.astro';
import Icon from '../components/ui/Icon.astro';
import { flags } from '../config/site';
import { faqs } from '../data/faqs';

const reviewed = [
  { icon: 'shield', title: 'Microsoft 365 secure score', body: 'Where your tenant sits against Microsoft’s own security baseline, and the gaps that matter.' },
  { icon: 'lock', title: 'MFA gaps', body: 'Who is not on multi-factor authentication, and any legacy authentication still letting attackers in.' },
  { icon: 'users', title: 'Admin accounts', body: 'How many people hold more access than they need — and whether leavers still have a way in.' },
  { icon: 'database', title: 'Backups', body: 'What is backed up, whether it is tested, and whether an attacker could reach the backup too.' },
  { icon: 'refresh', title: 'Patch status', body: 'How current your machines and servers are — including anything on Windows Server 2016.' },
  { icon: 'filecheck', title: 'One-page risk summary', body: 'Everything above, distilled into a single plain-language page with prioritised next steps.' },
] as const;
---

<BaseLayout
  title="IT & Security Health Check"
  description="A fixed-price review of your Microsoft 365 secure score, MFA gaps, admin accounts, backups and patch status — ending in a one-page risk summary and a prioritised list of what to fix."
  path="/health-check/"
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'IT & Security Health Check', path: '/health-check/' },
  ]}
  faqs={faqs['health-check']}
>
  <PageHero
    eyebrow="Start here"
    icon="filecheck"
    title="The IT & Security Health Check"
    intro="A fixed-price review of your current setup that ends in a one-page risk summary — so you know exactly what needs attention, and what it will cost, before you commit to anything."
    primaryCta={{ label: 'Request a Health Check', href: '#contact-form' }}
  />

  <Section tone="white">
    <SectionHeading eyebrow="What we review" title="Six areas, one clear report" class="mb-10" />
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {reviewed.map((r) => <ServiceCard icon={r.icon} title={r.title} body={r.body} />)}
    </div>
  </Section>

  <Section tone="soft">
    <div class="grid items-center gap-10 lg:grid-cols-2">
      <div>
        <SectionHeading eyebrow="The outcome" title="What you get" align="left" class="mb-6" />
        <ul class="space-y-3 text-slate-700">
          <li class="flex gap-3"><Icon name="check" size={20} class="mt-0.5 h-5 w-5 shrink-0 text-success" /> A one-page risk summary in plain language.</li>
          <li class="flex gap-3"><Icon name="check" size={20} class="mt-0.5 h-5 w-5 shrink-0 text-success" /> A prioritised list of what to fix first, and why.</li>
          <li class="flex gap-3"><Icon name="check" size={20} class="mt-0.5 h-5 w-5 shrink-0 text-success" /> A fixed quote if you want us to do the work — no obligation.</li>
          <li class="flex gap-3"><Icon name="check" size={20} class="mt-0.5 h-5 w-5 shrink-0 text-success" /> The report is yours to keep, whichever way you go.</li>
        </ul>
        <div class="mt-6 rounded-xl bg-white p-4 text-sm text-slate-600 ring-1 ring-slate-200">
          Price: <strong class="font-bold text-ink">{flags.showHealthCheckPrice ? 'R[CONFIRM]' : flags.healthCheckPriceLabel}</strong>
          {' '}— confirmed before any work starts.
          {!flags.showHealthCheckPrice && <span class="font-semibold text-warning-text"> [CONFIRM Health Check price]</span>}
        </div>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-6">
        <h3 class="text-lg font-bold text-ink">Who it suits</h3>
        <ul class="mt-3 space-y-2 text-sm text-slate-600">
          <li>Owner-run businesses with roughly 2–50 staff and no internal IT person.</li>
          <li>Anyone about to sign a managed-IT contract who wants a second opinion.</li>
          <li>Practices holding sensitive personal information who need POPIA-ready controls documented.</li>
          <li>Businesses still running Windows Server 2016.</li>
        </ul>
        <div class="mt-4"><PopiaNote /></div>
      </div>
    </div>
  </Section>

  <Section tone="white">
    <div class="mx-auto max-w-2xl">
      <ContactForm source="health-check" subject="IT & Security Health Check enquiry" heading="Request your Health Check" />
    </div>
  </Section>

  <Section tone="soft">
    <FaqAccordion items={faqs['health-check']} />
  </Section>
</BaseLayout>
