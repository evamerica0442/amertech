---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import CheckList from '../../components/ui/CheckList.astro';
import ServiceCard from '../../components/ui/ServiceCard.astro';
import FaqAccordion from '../../components/ui/FaqAccordion.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import { areas, type Area } from '../../data/areas';
import { site } from '../../config/site';
import { faqs } from '../../data/faqs';

export function getStaticPaths() {
  return areas.map((area) => ({ params: { slug: area.slug }, props: { area } }));
}

const { area } = Astro.props as { area: Area };
const others = areas.filter((a) => a.slug !== area.slug);
---

<BaseLayout
  title={area.title}
  description={area.description}
  path={area.path}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Areas', path: '/areas/' },
    { name: area.name, path: area.path },
  ]}
  faqs={faqs.areas}
>
  <PageHero
    eyebrow={area.homeBase ? 'Home base' : 'Areas'}
    icon="map"
    title={area.name}
    intro={area.intro}
    primaryCta={{ label: 'Get a Health Check', href: '/health-check/' }}
  />

  <Section tone="white">
    <SectionHeading eyebrow="Who we work with" title={`Business types in ${area.name}`} align="left" class="mb-8" />
    <CheckList columns={2} items={area.businessTypes} />
  </Section>

  <Section tone="soft">
    <SectionHeading eyebrow="Local concerns" title="What actually keeps owners up at night" class="mb-10" />
    <div class="grid gap-6 md:grid-cols-2">
      {
        area.concerns.map((c) => (
          <ServiceCard icon="alert" title={c.heading} body={c.body} />
        ))
      }
    </div>
  </Section>

  <Section tone="white">
    <div class="rounded-2xl border border-slate-200 bg-soft p-6 sm:p-8">
      <h2 class="text-xl font-extrabold text-ink">The service mix that fits {area.name}</h2>
      <p class="mt-3 text-slate-600">{area.serviceMix}</p>
      {
        area.websitesNote && (
          <div class="mt-5 rounded-xl border-l-4 border-l-success bg-white p-4">
            <p class="text-sm text-slate-700">{area.websitesNote}</p>
            <a href="/websites/" class="mt-2 inline-flex items-center gap-1 font-semibold text-deep">See website packages →</a>
          </div>
        )
      }
    </div>
  </Section>

  <Section tone="soft">
    <h2 class="text-2xl font-extrabold text-ink">Other areas we serve</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        others.map((a) => (
          <a href={a.path} class="card group flex items-center justify-between gap-3 hover:shadow-md">
            <span class="font-semibold text-ink group-hover:text-deep">{a.name}</span>
            <span class="text-slate-400 transition-transform group-hover:translate-x-1">→</span>
          </a>
        ))
      }
    </div>
  </Section>

  <Section tone="white">
    <FaqAccordion items={faqs.areas} />
  </Section>

  <CtaBand
    title={`IT help for your ${area.name} business`}
    body="Book a free chat or an IT & Security Health Check. On-site visits are by arrangement in the Western Cape."
    primary={{ label: 'Get a Health Check', href: '/health-check/' }}
    secondary={{ label: 'WhatsApp us', href: site.whatsappUrl }}
  />
</BaseLayout>
