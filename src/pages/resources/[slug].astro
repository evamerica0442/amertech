---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import Icon from '../../components/ui/Icon.astro';
import Button from '../../components/ui/Button.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import { resources, type Resource } from '../../data/resources';
import { site } from '../../config/site';

export function getStaticPaths() {
  return resources.map((r) => ({ params: { slug: r.slug }, props: { resource: r } }));
}

const { resource } = Astro.props as { resource: Resource };
---

<BaseLayout
  title={resource.title}
  description={resource.description}
  path={resource.path}
  ogType="article"
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Resources', path: '/resources/' },
    { name: resource.title, path: resource.path },
  ]}
>
  <article>
    <header class="glow-navy on-dark">
      <div class="mx-auto w-full max-w-3xl px-4 py-14 sm:px-6 md:py-20">
        <p class="mb-3 inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs font-bold uppercase tracking-wider text-blue">
          <Icon name="alert" size={14} /> Draft — [REVIEW BEFORE PUBLISHING]
        </p>
        <p class="text-sm text-silver">{new Date(resource.date).toLocaleDateString('en-ZA', { day: 'numeric', month: 'long', year: 'numeric' })} · {resource.readMinutes} min read</p>
        <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">{resource.title}</h1>
        <p class="mt-4 text-lg text-silver">{resource.intro}</p>
      </div>
    </header>

    <Section tone="white">
      <div class="mx-auto max-w-3xl">
        {
          resource.sections.map((s) => (
            <section class="mb-10">
              <h2 class="text-2xl font-extrabold text-ink">{s.heading}</h2>
              {s.body.map((para) => (
                <p class="mt-3 leading-relaxed text-slate-700">{para}</p>
              ))}
              {s.bullets && (
                <ul class="mt-4 space-y-2">
                  {s.bullets.map((b) => (
                    <li class="flex gap-3 text-slate-700">
                      <Icon name="check" size={20} class="mt-0.5 h-5 w-5 shrink-0 text-success" />
                      <span>{b}</span>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          ))
        }

        <div class="mt-8 rounded-2xl border border-slate-200 bg-soft p-6">
          <h3 class="text-lg font-bold text-ink">Put this into practice</h3>
          <p class="mt-2 text-slate-600">{resource.cta}</p>
          <div class="mt-4 flex flex-col gap-3 sm:flex-row">
            <Button href="/health-check/" variant="primary" icon="arrow-right" iconRight>Book a Health Check</Button>
            <Button href={site.whatsappUrl} variant="whatsapp" external icon="whatsapp">WhatsApp us</Button>
          </div>
        </div>

        <div class="mt-8">
          <a href="/resources/" class="inline-flex items-center gap-1 font-semibold text-deep">← All resources</a>
        </div>
      </div>
    </Section>
  </article>

  <CtaBand
    title="Prefer we just handle it?"
    body="Fixed-price managed IT with a named engineer. Start with a free chat."
    primary={{ label: 'Get a fixed quote', href: '/health-check/' }}
    secondary={{ label: 'WhatsApp us', href: site.whatsappUrl }}
  />
</BaseLayout>
