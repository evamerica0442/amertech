---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import CheckList from '../../components/ui/CheckList.astro';
import ServiceCard from '../../components/ui/ServiceCard.astro';
import FaqAccordion from '../../components/ui/FaqAccordion.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import PopiaNote from '../../components/ui/PopiaNote.astro';
import { site } from '../../config/site';
import { faqs } from '../../data/faqs';
---

<BaseLayout
  title="Security & POPIA-ready IT controls"
  description="MFA, patching, backups, endpoint protection, phishing awareness, access reviews and a breach-response runbook — the IT controls that support your POPIA obligations, documented in plain language."
  path="/services/security-popia-ready-it/"
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services/managed-it-support/' },
    { name: 'Security & POPIA-ready IT', path: '/services/security-popia-ready-it/' },
  ]}
  faqs={faqs['security']}
>
  <PageHero
    eyebrow="Security & POPIA-ready IT"
    icon="shield"
    title="Secure by default, and ready for the POPIA questions"
    intro="The practical IT controls that protect personal information — MFA, patching, backups, endpoint protection, access reviews and a written breach-response plan — documented so your attorney can work with them."
    primaryCta={{ label: 'Book a Security Health Check', href: '/health-check/' }}
  />

  <Section tone="white">
    <div class="mb-10"><PopiaNote /></div>
    <SectionHeading eyebrow="What we put in place" title="The controls that stop most incidents" align="left" class="mb-8" />
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <ServiceCard icon="lock" title="Multi-factor authentication" body="MFA on every account, with legacy authentication switched off — the single biggest win for a small business." />
      <ServiceCard icon="refresh" title="Patching" body="Windows, browsers and anything internet-facing kept current on a schedule that suits your trading hours." />
      <ServiceCard icon="database" title="Backups & restore tests" body="Backups of mail, files and line-of-business data, with a tested, offline copy and a timed restore." />
      <ServiceCard icon="shield" title="Endpoint protection" body="Sensible, monitored protection on laptops and servers — not a subscription you never look at." />
      <ServiceCard icon="chat" title="Phishing awareness" body="Short, practical guidance for whoever opens the inbox first, plus filtering that actually filters." />
      <ServiceCard icon="users" title="Access reviews" body="Regular reviews of who can reach what, with least-privilege applied and leavers removed on time." />
    </div>
  </Section>

  <Section tone="soft">
    <div class="grid items-start gap-10 lg:grid-cols-2">
      <div>
        <SectionHeading eyebrow="Breach response" title="A plan before the bad day" align="left" class="mb-6" />
        <CheckList
          columns={1}
          items={[
            'A one-page runbook: who calls whom, what to isolate, what to preserve',
            'Evidence handling so an incident is not made worse by panic',
            'Notification guidance for the Information Regulator and affected people, coordinated with your attorney',
            'An annual security review with a partner attorney',
          ]}
        />
        <p class="mt-4 text-sm text-slate-600">
          We help execute the plan; we do not improvise during an incident.
        </p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-6">
        <h3 class="text-lg font-bold text-ink">What we do <em>not</em> claim</h3>
        <ul class="mt-3 space-y-2 text-sm text-slate-600">
          <li class="flex gap-2"><span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-warning" /> We do not say our work makes you “POPIA compliant”.</li>
          <li class="flex gap-2"><span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-warning" /> We do not give legal advice — that comes from an attorney.</li>
          <li class="flex gap-2"><span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-warning" /> We do not invent response-time or uptime guarantees.</li>
        </ul>
        <p class="mt-4"><PopiaNote /></p>
      </div>
    </div>
  </Section>

  <Section tone="white">
    <FaqAccordion items={faqs['security']} />
  </Section>

  <CtaBand
    title="See your current risk in one page"
    body="The Health Check reviews MFA gaps, admin accounts, backups, patch status and your Microsoft 365 secure score, then hands you a plain-language summary."
    primary={{ label: 'Book a Health Check', href: '/health-check/' }}
    secondary={{ label: 'WhatsApp us', href: site.whatsappUrl }}
  />
</BaseLayout>
