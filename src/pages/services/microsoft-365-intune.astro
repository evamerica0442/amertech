---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import CheckList from '../../components/ui/CheckList.astro';
import ServiceCard from '../../components/ui/ServiceCard.astro';
import FaqAccordion from '../../components/ui/FaqAccordion.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import Icon from '../../components/ui/Icon.astro';
import { site } from '../../config/site';
import { faqs } from '../../data/faqs';
---

<BaseLayout
  title="Microsoft 365 & Intune administration"
  description="Microsoft 365 tenant set-up and clean-up, email migrations, Intune device management, Entra ID and conditional access — administered by a senior engineer who does it at scale."
  path="/services/microsoft-365-intune/"
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services/managed-it-support/' },
    { name: 'Microsoft 365 & Intune', path: '/services/microsoft-365-intune/' },
  ]}
  faqs={faqs['m365']}
>
  <PageHero
    eyebrow="Microsoft 365 & Intune"
    icon="cloud"
    title="Microsoft 365 that is clean, secure and correctly licensed"
    intro="Tenant set-up and clean-up, migrations from older email or hosting, Intune device management, Entra ID and conditional access — done by someone who administers it at scale."
    primaryCta={{ label: 'Book a tenant review', href: '/health-check/' }}
  />

  <Section tone="white">
    <SectionHeading eyebrow="What we do" title="The Microsoft 365 work that actually matters" align="left" class="mb-8" />
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <ServiceCard icon="wrench" title="Tenant set-up & clean-up" body="Proper groups, shared mailboxes, naming and an end to the sprawl of orphaned accounts and duplicate licences." />
      <ServiceCard icon="refresh" title="Email migrations" body="From cPanel/POP, Google Workspace or older Exchange — planned so nothing bounces during the switch." />
      <ServiceCard icon="monitor" title="Intune device management" body="Laptops, phones and tablets enrolled, encrypted and policy-managed, with a remote wipe that respects personal data." />
      <ServiceCard icon="key" title="Entra ID & conditional access" body="Microsoft's identity system configured so the right people reach the right things, from the right devices." />
      <ServiceCard icon="lock" title="MFA & sign-in security" body="Multi-factor authentication enforced everywhere, with legacy authentication turned off." />
      <ServiceCard icon="rand" title="Licensing guidance" body="Right-sized licences — Business Standard vs E3, and removing mailboxes of people who left." />
    </div>
  </Section>

  <Section tone="soft">
    <div class="grid items-start gap-10 lg:grid-cols-2">
      <div>
        <SectionHeading eyebrow="A typical clean-up" title="Where the money and the risk hide" align="left" class="mb-6" />
        <CheckList
          columns={1}
          items={[
            'Inventory every user, licence, shared mailbox and group',
            'Disable (not delete) leaver accounts; keep the mailbox 30 days',
            'Enforce MFA and close legacy authentication',
            'Align SPF, DKIM and DMARC so your domain is not spoofed',
            'Move file shares to SharePoint/OneDrive with role-based access',
            'Right-size licences and cut recurring spend',
          ]}
        />
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-6">
        <div class="flex items-center gap-3">
          <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-soft text-deep"><Icon name="filecheck" size={24} /></span>
          <h3 class="text-lg font-bold text-ink">Licensing route</h3>
        </div>
        <p class="mt-3 text-slate-600">
          We work within your existing licensing relationship, or advise on a route that fits. We are not claiming
          Microsoft CSP or partner status here.
        </p>
        <p class="mt-3 rounded-lg bg-soft p-3 text-sm text-slate-600">
          <span class="font-semibold text-warning-text">[CONFIRM licensing route]</span> — how we will supply or manage your
          licences.
        </p>
      </div>
    </div>
  </Section>

  <Section tone="white">
    <FaqAccordion items={faqs['m365']} />
  </Section>

  <CtaBand
    title="Is your Microsoft 365 tenant as secure as you think?"
    body="The Health Check reviews your secure score, MFA gaps, admin accounts and licences, and gives you a one-page summary."
    primary={{ label: 'Book a Health Check', href: '/health-check/' }}
    secondary={{ label: 'WhatsApp us', href: site.whatsappUrl }}
  />
</BaseLayout>
